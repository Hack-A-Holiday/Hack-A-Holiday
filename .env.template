# ========================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# ========================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to version control

# ========================================
# AWS CONFIGURATION (REQUIRED)
# ========================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here

# ========================================
# BEDROCK MODEL CONFIGURATION (REQUIRED)
# ========================================
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
FAST_MODEL=amazon.nova-lite-v1:0
REASONING_MODEL=amazon.nova-pro-v1:0

# ========================================
# BEDROCK AGENT CONFIGURATION (OPTIONAL)
# ========================================
BEDROCK_AGENT_ID=your_bedrock_agent_id
BEDROCK_AGENT_ALIAS_ID=your_bedrock_agent_alias_id

# ========================================
# DYNAMODB TABLE NAMES (REQUIRED)
# ========================================
CHAT_TABLE=HackAHolidayChatHistory
USERS_TABLE=HackAHolidayUsers
TRIPS_TABLE=TravelCompanion-Trips-dev
CHAT_HISTORY_TABLE=TravelCompanion-ChatHistory-dev
DYNAMODB_USER_TABLE=travel-users

# ========================================
# JWT AUTHENTICATION (REQUIRED)
# ========================================
JWT_SECRET=your_super_secure_jwt_secret_key_here

# ========================================
# SERVER CONFIGURATION (REQUIRED)
# ========================================
PORT=4000

# ========================================
# EXTERNAL API KEYS (OPTIONAL)
# ========================================
TRIPADVISOR_API_KEY=your_tripadvisor_api_key
RAPIDAPI_KEY=your_rapidapi_key

# ========================================
# SAGEMAKER CONFIGURATION (OPTIONAL)
# ========================================
SAGEMAKER_ENDPOINT_NAME=travel-assistant-endpoint

# ========================================
# FRONTEND CONFIGURATION (REQUIRED)
# ========================================
# For Next.js frontend - must start with NEXT_PUBLIC_
NEXT_PUBLIC_API_URL=http://localhost:4000

# ========================================
# PRODUCTION CONFIGURATION
# ========================================
# For production deployment, update these values:
# NEXT_PUBLIC_API_URL=https://your-production-api-domain.com
# PORT=80 or 443 (depending on your setup)

# ========================================
# NOTES
# ========================================
# 1. All environment variables are now REQUIRED - no fallbacks
# 2. Make sure to set all values before running the application
# 3. Use strong, unique values for JWT_SECRET
# 4. Keep your AWS credentials secure and never commit them
# 5. Update NEXT_PUBLIC_API_URL for production deployment